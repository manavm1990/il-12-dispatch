{
  "name": "il-12-dispatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "bun run typegen && bun run tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test",
    "typegen": "bunx sanity@latest schema extract --force --enforce-required-fields --path=sanity/extract.json && bunx sanity@latest typegen generate",
    "skills:update": "skills update -y -p && rm -rf .claude",
    "prepare": "husky"
  },
  "lint-staged": {
    "!(sanity.types).{ts,tsx}": [
      "biome format --write",
      "biome check --no-errors-on-unmatched",
      "tsc-files --noEmit --pretty false --incremental false"
    ]
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sanity/client": "^8.6.2",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.14.1",
    "@vercel/speed-insights": "^2.0.0",
    "@wrksz/themes": "^2.0.0-beta.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "next": "16.3.5",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.9.5",
    "resend": "^6.28.1",
    "sanity": "^6.14.1",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@react-email/ui": "6.9.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "skills": "1.5.26",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
